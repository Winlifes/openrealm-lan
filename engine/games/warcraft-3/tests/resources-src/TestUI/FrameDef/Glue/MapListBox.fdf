Frame "LISTBOX" "MapListBox" {
    Width 0.36,
    Height 0.27,
    ControlBackdrop "MapListBoxBackdrop",
    Frame "BACKDROP" "MapListBoxBackdrop" {
        SetAllPoints,
    }
    Frame "SCROLLBAR" "MapListScrollBar" INHERITS WITHCHILDREN "StandardScrollBarTemplate" {
        SetPoint TOPRIGHT, "MapListBox", TOPRIGHT, 0, 0,
        SetPoint BOTTOMRIGHT, "MapListBox", BOTTOMRIGHT, 0, 0,
    }
}
